{
  "name": "auto-shoping-work",
  "version": "2.1.8",
  "description": "影随 TraceFlow - 网页操作录制与智能回放，让每一次操作如影随形",
  "main": "dist-electron/main.js",
  "author": "autoShopingWork",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run copy:preload",
    "gen:version-info": "node scripts/gen-version-info.mjs",
    "copy:preload": "node scripts/copy-preload.mjs",
    "clean:electron": "node scripts/clean-electron.mjs",
    "build": "npm run gen:version-info && npm run clean:electron && vite build && npm run copy:preload",
    "build:electron": "npm run gen:version-info && npm run clean:electron && vite build && npm run copy:preload && electron-builder",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:script-manager": "node tests/script-manager/run-test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "bindings": "^1.5.0",
    "electron-log": "^5.2.0",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "file-uri-to-path": "^2.0.0",
    "nodemailer": "^10.0.12",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/tsconfig": "^0.5.1",
    "electron": "^36.9.5",
    "electron-builder": "^24.13.3",
    "element-plus": "^2.14.6",
    "pinia": "^2.2.6",
    "sass": "^1.81.0",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.6",
    "vue": "^3.5.43",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.1.10"
  }
}
